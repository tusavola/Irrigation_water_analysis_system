#include <Arduino.h>
#include <ESP32Servo.h>
Servo myservo; 
int servoPin = 6;
int pos = 0; 
#define MOSFET_ENABLE 5

RTC_DATA_ATTR int bootCount = 0;
#define uS_TO_S_FACTOR 1000000ULL /* Conversion factor for micro seconds to seconds */
#define TIME_TO_SLEEP  86400

void print_wakeup_reason()
{
  esp_sleep_wakeup_cause_t wakeup_reason;
  wakeup_reason = esp_sleep_get_wakeup_cause();
  switch(wakeup_reason)
  {
    case ESP_SLEEP_WAKEUP_TIMER : Serial.println("Wakeup caused by timer"); break;
    default : Serial.printf("Wakeup was not caused by deep sleep: %d\n",wakeup_reason); break;
  }
}

void setup() 
{
  // put your setup code here, to run once:
  Serial.begin(115200);
  pinMode(MOSFET_ENABLE, OUTPUT);
  waitfordelay(2000);
  ++bootCount; //Increament the boot number and print at every boot
  Serial.println("Boot number: " + String(bootCount));
  print_wakeup_reason(); //PRINT THE WAKE UP REASON

  esp_sleep_enable_timer_wakeup(TIME_TO_SLEEP * uS_TO_S_FACTOR); //wake up using timer
  Serial.println("Setup ESP32 to sleep for every " + String(TIME_TO_SLEEP) + " Seconds");
  waitfordelay(1000);

  digitalWrite(MOSFET_ENABLE, HIGH); // MOSFET ON
	Serial.println("Gate activated");
  ESP32PWM::allocateTimer(0);
	ESP32PWM::allocateTimer(1);
	ESP32PWM::allocateTimer(2);
	ESP32PWM::allocateTimer(3);
	myservo.setPeriodHertz(50);    // standard 50 hz servo
	myservo.attach(servoPin, 950, 2300);  //adjust the values according to the spin angle needed
  waitfordelay(10000);

  for (pos = 0; pos <= 110; pos += 1) 
  { 
		myservo.write(pos);    // tell servo to go to position in variable 'pos'
		waitfordelay(15);             // waits 15ms for the servo to reach the position
	}

  waitfordelay(10000);   //Needs to measure time to take to empty the tank.....

  for (pos = 110; pos >= 0; pos -= 1) 
  { // goes from 180 degrees to 0 degrees
		myservo.write(pos);    // tell servo to go to position in variable 'pos'
		waitfordelay(15);             // waits 15ms for the servo to reach the position
	}

  waitfordelay(1000);
  digitalWrite(MOSFET_ENABLE, LOW);  // MOSFET OFF
	Serial.println("Gate deactivated");  
  waitfordelay(10000);
  Serial.println("Going o sleep now");
  Serial.flush();
  esp_deep_sleep_start();
  Serial.println("This will never be printed");
}

void loop() {
}

void waitfordelay(unsigned long time_ms)
{
  unsigned long start = millis();
  while (millis() - start < time_ms) 
  {
    delay(1); // Allow  RTOS to run
  }
  return;
}
